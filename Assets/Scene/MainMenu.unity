      m_Calls: []
  m_text: "Story:\nOh noes! School is out, but your friend has a problem! He left all his noteboos in school, but doesn't have time to go get them, because if he does he'll be late for eating pracitce. To help him out, you have to go back in the school and find all 7 of his notebooks for him. It won't be easy though! Baldi loves challenging his students with fun trivia problems whenever he can! Each time you find a notebook, you'll have to answer some questions. Answer all three correctly, and you will earn a prize! Find all 7 notebooks, and then exit the school, to win!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0e45f3d6f79891e42b9f9e5b6e5f28be, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: d6d4af44d0640e6489ba1f3861d60953, type: 2}
